# cmake -DOUTPUT=<header> -DNAMES=<a;b> -DINPUTS=<a.vws;b.vws> -P EmbedShaders.cmake
# Writes a header with each .vws file as a byte array and a lookup by name.
set(content "// Generated by EmbedShaders.cmake from vw's built-in shaders. Do not edit.\n#pragma once\n\n#include <cstdint>\n#include <span>\n#include <string_view>\n\nnamespace vw::builtin_shaders {\n\n")
set(lookup "")
list(LENGTH NAMES count)
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
  list(GET NAMES ${index} name)
  list(GET INPUTS ${index} input)
  file(READ "${input}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x..,){24})" "\\1\n  " bytes "${bytes}")
  string(APPEND content "alignas(4) inline constexpr std::uint8_t ${name}[] = {\n  ${bytes}\n};\n\n")
  string(APPEND lookup "  if (name == \"${name}\") return ${name};\n")
endforeach()
string(APPEND content "inline std::span<const std::uint8_t> find(std::string_view name) {\n${lookup}  return {};\n}\n\n}  // namespace vw::builtin_shaders\n")
file(WRITE "${OUTPUT}.tmp" "${content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
