@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json)

# A static libvw leaves its libraries to the program that links it.
set(VW_STATIC @VW_STATIC@)
if(VW_STATIC)
  find_dependency(Vulkan)
  find_dependency(PkgConfig)
  foreach(module "FREETYPE freetype2" "FONTCONFIG fontconfig" "HARFBUZZ harfbuzz"
                 "GIO_UNIX gio-unix-2.0" "GTK3 gtk+-3.0" "PIPEWIRE libpipewire-0.3"
                 "RSVG librsvg-2.0" "XKBCOMMON xkbcommon" "PANGOCAIRO pangocairo" "WEBP libwebp")
    separate_arguments(module)
    list(GET module 0 prefix)
    list(GET module 1 name)
    if(NOT TARGET PkgConfig::${prefix})
      pkg_check_modules(${prefix} REQUIRED IMPORTED_TARGET ${name})
    endif()
  endforeach()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/vwTargets.cmake")
# vw_compile_shader(): GLSL to .vws with the installed vw::shaderc.
include("${CMAKE_CURRENT_LIST_DIR}/VwShaders.cmake")
# facet_compile(): only when vw was built with -DVW_WITH_FACET=ON.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/VwFacet.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/VwFacet.cmake")
endif()
check_required_components(vw)
