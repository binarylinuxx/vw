# cmake -DOUTPUT=<header> -DTEMPLATE_DIR=<templates/default> -P EmbedTemplates.cmake
# Writes a header with the project template's files as string literals, for
# `vw --init` and `vw --init-nix`.
set(content "// Generated by EmbedTemplates.cmake from templates/default. Do not edit.\n#pragma once\n\n#include <string_view>\n\nnamespace vw::project_template {\n\n")
foreach(entry "cmakelists:CMakeLists.txt" "main_cpp:main.cpp" "gitignore:.gitignore" "flake_nix:flake.nix")
  string(REPLACE ":" ";" parts "${entry}")
  list(GET parts 0 name)
  list(GET parts 1 file)
  file(READ "${TEMPLATE_DIR}/${file}" text)
  if(text MATCHES "\\)vwtemplate\"")
    message(FATAL_ERROR "${file} contains the raw string delimiter")
  endif()
  string(APPEND content "inline constexpr std::string_view ${name} = R\"vwtemplate(${text})vwtemplate\";\n\n")
endforeach()
string(APPEND content "}  // namespace vw::project_template\n")
file(WRITE "${OUTPUT}.tmp" "${content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
