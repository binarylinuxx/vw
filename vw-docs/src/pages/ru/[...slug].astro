---
// Russian pages: the translation when there is one, else the English page
// with a note, so every link under /ru/ works.
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const english = await getCollection('docs');
  const russian = new Map((await getCollection('ru')).map((entry) => [entry.id, entry]));
  return english.map((entry) => ({
    params: { slug: entry.id },
    props: { entry: russian.get(entry.id) ?? entry, untranslated: !russian.has(entry.id) },
  }));
}
const { entry, untranslated } = Astro.props;
const { Content, headings } = await render(entry);
---
<DocsLayout title={entry.data.title} description={entry.data.description} slug={entry.id} headings={headings} locale="ru" untranslated={untranslated}>
  <Content />
</DocsLayout>
