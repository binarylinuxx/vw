---
import Icon from './Icon.astro';
---
<dialog id="search" class="search-dialog" aria-label="Search the documentation">
  <div class="search-field">
    <Icon name="search" />
    <input id="search-query" type="search" placeholder="Search widgets, services, guides…" autocomplete="off" enterkeyhint="go" />
    <button class="icon-btn" type="button" data-search-close aria-label="Close search"><Icon name="close" /></button>
  </div>
  <p class="search-status" id="search-status" role="status"></p>
  <div class="search-results" id="search-results" role="listbox"></div>
</dialog>

<script>
  import { pageUrl } from '../data/navigation';
  type Entry = { title: string; description: string; slug: string; section: string; body: string };
  const dialog = document.querySelector<HTMLDialogElement>('#search')!;
  const input = document.querySelector<HTMLInputElement>('#search-query')!;
  const results = document.querySelector<HTMLDivElement>('#search-results')!;
  const status = document.querySelector<HTMLParagraphElement>('#search-status')!;
  let index: Promise<Entry[]> | undefined;
  let links: HTMLAnchorElement[] = [];
  let selected = 0;

  function select(position: number) {
    selected = Math.max(0, Math.min(links.length - 1, position));
    links.forEach((link, i) => link.classList.toggle('is-selected', i === selected));
    links[selected]?.scrollIntoView({ block: 'nearest' });
  }

  async function run() {
    try {
      index ??= fetch(`${pageUrl('')}search-index.json`).then((r) => r.json());
      const entries = await index;
      const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const scored = entries
        .map((entry) => {
          const title = entry.title.toLowerCase();
          const text = `${title} ${entry.description.toLowerCase()} ${entry.body.toLowerCase()}`;
          if (!words.every((w) => text.includes(w))) return null;
          const score = words.reduce((s, w) => s + (title.includes(w) ? 10 : 0) + (entry.description.toLowerCase().includes(w) ? 3 : 0), 0);
          return { entry, score };
        })
        .filter((x): x is { entry: Entry; score: number } => x !== null)
        .sort((a, b) => b.score - a.score)
        .slice(0, words.length ? 14 : 8);
      results.replaceChildren();
      links = scored.map(({ entry }, i) => {
        const a = document.createElement('a');
        a.className = 'search-result';
        a.href = pageUrl(entry.slug);
        a.setAttribute('role', 'option');
        const s = document.createElement('small'); s.textContent = entry.section;
        const t = document.createElement('strong'); t.textContent = entry.title;
        const d = document.createElement('span'); d.textContent = entry.description;
        a.append(s, t, d);
        a.addEventListener('pointermove', () => select(i));
        results.append(a);
        return a;
      });
      select(0);
      status.textContent = words.length ? `${scored.length} match${scored.length === 1 ? '' : 'es'}` : 'Good places to start';
    } catch {
      index = undefined;
      status.textContent = 'Search could not load.';
    }
  }

  function open() {
    if (!dialog.open) dialog.showModal();
    input.focus();
    void run();
  }
  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
  document.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  input.addEventListener('input', () => void run());
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); select(selected + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); select(selected - 1); }
    else if (e.key === 'Enter' && links[selected]) { e.preventDefault(); location.href = links[selected].href; }
  });
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open(); }
    else if (e.key === '/' && !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement)) { e.preventDefault(); open(); }
  });
</script>
