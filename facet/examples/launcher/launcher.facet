// An app launcher in Facet: a search field over a grid of installed apps.
// main.cpp owns the state and the actions; this file owns the layout.
let [ vw.ui as ui, vw.layout as layout ] in

view Launcher(state, actions) {
    ui.Surface(width: 560, height: 440, anchor: center, layer: overlay) {
        layout.Column(gap: 14, padding: 18, width: 560, height: 440, bg: "#151a1ef0", radius: 26) {
            ui.TextField(
                id: "query", value: state.query, placeholder: "Type to search",
                width: "100%", height: 42, radius: 12,
                color: "#20272c", focus_color: "#a7cbe7", text_color: "#dfe6ee",
                on_change: actions.search,
                on_submit: actions.open_first
            )
            layout.Grid(columns: 4, gap: 12, width: "100%") {
                for app in state.apps key app.id {
                    ui.Rectangle(
                        width: "100%", height: 96, radius: 16, color: "#20272c",
                        input: { on_click: () => actions.open(app.id), hover: { color: "#262d33" } }
                    ) {
                        layout.Column(gap: 8, align: center) {
                            ui.Image(path: app.icon, width: 40, height: 40, fit: contain)
                            ui.Text(text: app.name, size: 12, color: "#dfe6ee", max_width: 104, max_lines: 1)
                        }
                    }
                }
            }
            if state.apps.length == 0 {
                ui.Text(text: "Nothing matches", size: 14, color: "#6f767d")
            }
        }
    }
}
